NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GATEWAY_URL=https://your-worker.your-subdomain.workers.dev
SUPABASE_SERVICE_ROLE_KEY=
OTP_SECRET=
DATABASE_URL=

# Redis Configuration (Redis Cloud)
# SECURITY: Replace with your actual Redis credentials - never commit real passwords
REDIS_URL=redis://default:YOUR_PASSWORD_HERE@redis-14853.crce262.us-east-1-1.ec2.cloud.redislabs.com:14853

# MongoDB Configuration (MongoDB Atlas)
# SECURITY: Replace with your actual MongoDB credentials - never commit real passwords
MONGODB_URI=mongodb+srv://username:YOUR_PASSWORD_HERE@zamschoolos.8luqlsw.mongodb.net/zamschool

# SMTP Email Configuration (Gmail Example)
# SECURITY: Use app-specific passwords, not your main account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD_HERE
SMTP_FROM=your-email@gmail.com

# Security Configuration
# Set to 'true' only when running behind a trusted reverse proxy/load balancer
TRUSTED_PROXY=false
