{
  "name": "zamschool-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node ./scripts/prepare-standalone.mjs",
    "prestart": "node ./scripts/prepare-standalone.mjs",
    "start": "node --env-file=.env.local ./scripts/start-standalone.mjs",
    "lint": "eslint .",
    "clean": "rm -rf .next .next_broken_*",
    "healthcheck": "node ./scripts/healthcheck.mjs",
    "schema:check": "node ./scripts/schema-check.mjs",
    "schema:check:strict": "node ./scripts/schema-check.mjs --strict",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:lib": "node --test lib/**/*.test.mjs",
    "test:root": "node --test *.test.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@google/genai": "^1.17.0",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@types/papaparse": "^5.5.2",
    "@types/react-big-calendar": "^1.16.3",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.553.0",
    "moment": "^2.30.1",
    "mongoose": "^9.3.2",
    "motion": "^12.23.24",
    "nanoid": "^5.1.6",
    "next": "^15.4.9",
    "nodemailer": "^8.0.2",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.6",
    "react": "^19.2.1",
    "react-big-calendar": "^1.19.4",
    "react-calendar": "^6.0.0",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.71.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "firebase-tools": "^15.10.0",
    "pg": "^8.20.0",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "protobufjs": ">=7.2.5",
    "rimraf": "^4.0.0",
    "@tootallnate/once": ">=3.0.1"
  }
